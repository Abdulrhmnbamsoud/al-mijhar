datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------
// 1. Core: Guest & Episode Project
// -----------------------------------------

model Guest {
  id             String           @id @default(uuid())
  name           String
  role           String?
  organization   String?
  country        String?
  url            String?
  twitterUrl     String?
  linkedinUrl    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  projects       EpisodeProject[]
}

model EpisodeProject {
  id                String           @id @default(uuid())
  title             String?          // e.g., "حلقة نورة السالم"
  status            String           @default("draft") // "draft", "researching", "pre_interview", "editing", "reviewing", "ready"
  durationMinutes   Int?             @default(60)
  notes             String?

  guestId           String
  guest             Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relationships
  sources           Source[]
  preInterviews     PreInterview[]
  storyMoments      StoryMoment[]
  openQuestions     OpenQuestion[]
  episodeAngles     EpisodeAngle[]
  reviewFindings    ReviewFinding[]
  approvals         Approval[]
  generationRuns    GenerationRun[]
  auditEvents       AuditEvent[]
}

// -----------------------------------------
// 2. Research & Sourcing
// -----------------------------------------

model Source {
  id             String           @id @default(uuid())
  type           String           // "article", "video", "audio", "social", "document", "other"
  title          String
  originalUrl    String?
  publisher      String?
  publishedAt    DateTime?
  processingStatus String         @default("pending") // "pending", "processing", "completed", "failed"
  extractedText  String?
  
  projectId      String
  project        EpisodeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
  
  excerpts       SourceExcerpt[]
}

model SourceExcerpt {
  id             String           @id @default(uuid())
  content        String
  startTime      String?          // For audio/video (e.g., "12:34")
  endTime        String?
  
  sourceId       String
  source         Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // Link to moments or questions
  storyMoments   StoryMomentExcerpt[]
  followUps      FollowUp[]
  hostQuestions  HostQuestion[]
  
  createdAt      DateTime         @default(now())
}

// -----------------------------------------
// 3. Pre-Interview
// -----------------------------------------

model PreInterview {
  id             String           @id @default(uuid())
  date           DateTime?
  conductedBy    String?
  transcript     String?
  
  projectId      String
  project        EpisodeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  notes          PreInterviewNote[]
  createdAt      DateTime         @default(now())
}

model PreInterviewNote {
  id             String           @id @default(uuid())
  question       String?
  answer         String?
  note           String
  author         String?
  isSensitive    Boolean          @default(false)
  needsVerification Boolean       @default(false)

  preInterviewId String
  preInterview   PreInterview     @relation(fields: [preInterviewId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
}

// -----------------------------------------
// 4. Narrative & Structure
// -----------------------------------------

model StoryMoment {
  id             String           @id @default(uuid())
  title          String
  description    String
  status         String           @default("draft") // "draft", "verified", "disputed", "guest_claim"
  
  projectId      String
  project        EpisodeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  excerpts       StoryMomentExcerpt[]
  chapters       Chapter[]
  createdAt      DateTime         @default(now())
}

// Join table for many-to-many relationship
model StoryMomentExcerpt {
  storyMomentId  String
  storyMoment    StoryMoment      @relation(fields: [storyMomentId], references: [id], onDelete: Cascade)
  excerptId      String
  excerpt        SourceExcerpt    @relation(fields: [excerptId], references: [id], onDelete: Cascade)

  @@id([storyMomentId, excerptId])
}

model OpenQuestion {
  id             String           @id @default(uuid())
  question       String
  context        String?
  status         String           @default("open") // "open", "asked", "resolved"
  
  projectId      String
  project        EpisodeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
}

model EpisodeAngle {
  id             String           @id @default(uuid())
  angle          String           // "زاوية الحلقة في جملة واحدة"
  isActive       Boolean          @default(false)
  
  projectId      String
  project        EpisodeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  chapters       Chapter[]
  createdAt      DateTime         @default(now())
}

model Chapter {
  id             String           @id @default(uuid())
  title          String
  orderIndex     Int
  estimatedMinutes Int?

  angleId        String
  angle          EpisodeAngle     @relation(fields: [angleId], references: [id], onDelete: Cascade)

  momentId       String?
  moment         StoryMoment?     @relation(fields: [momentId], references: [id], onDelete: SetNull)

  hostQuestions  HostQuestion[]
}

model HostQuestion {
  id             String           @id @default(uuid())
  question       String
  orderIndex     Int
  whyItMatters   String?
  
  chapterId      String
  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  // Direct link to the source if applicable
  excerptId      String?
  excerpt        SourceExcerpt?   @relation(fields: [excerptId], references: [id], onDelete: SetNull)

  followUps      FollowUp[]
}

model FollowUp {
  id             String           @id @default(uuid())
  question       String
  orderIndex     Int

  hostQuestionId String
  hostQuestion   HostQuestion     @relation(fields: [hostQuestionId], references: [id], onDelete: Cascade)

  excerptId      String?
  excerpt        SourceExcerpt?   @relation(fields: [excerptId], references: [id], onDelete: SetNull)
}

// -----------------------------------------
// 5. Review & Governance
// -----------------------------------------

model ReviewFinding {
  id             String           @id @default(uuid())
  type           String           // "repetition", "weak_axis", "unverified_info", "sudden_shift", "sensitive", "over_time"
  message        String
  severity       String           // "info", "warning", "critical"
  status         String           @default("open") // "open", "ignored", "resolved"
  ignoreReason   String?

  projectId      String
  project        EpisodeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
}

model Approval {
  id             String           @id @default(uuid())
  version        Int
  approvedBy     String?
  notes          String?
  snapshot       String           // JSON string of the complete approved episode structure

  projectId      String
  project        EpisodeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
}

// -----------------------------------------
// 6. Agents & Auditing
// -----------------------------------------

model GenerationRun {
  id             String           @id @default(uuid())
  agentRole      String           // "researcher", "fact_checker", "pre_interviewer", "editor", "question_writer", "reviewer", "presenter_copy"
  status         String           // "pending", "running", "completed", "failed"
  inputSnapshot  String?          // JSON
  outputSnapshot String?          // JSON
  error          String?

  projectId      String
  project        EpisodeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model AuditEvent {
  id             String           @id @default(uuid())
  action         String
  entityType     String
  entityId       String
  changes        String?          // JSON describing what changed
  userId         String?          // If done by human

  projectId      String
  project        EpisodeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
}
